{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Business": {
      "title": "Business",
      "description": "Business profile and organizational configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerId": { "type": "string" },
        "businessType": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "currency": { "type": "string" },
        "invoicePrefix": { "type": "string" },
        "nextInvoiceNumber": { "type": "number" },
        "financialYear": { "type": "string" },
        "logoUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerId", "currency"]
    },
    "BusinessMember": {
      "title": "BusinessMember",
      "description": "Association between user and business with access role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "manager", "accountant", "salesperson", "inventory_manager"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "userId", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "openingStock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "purchasePrice", "sellingPrice"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "openingBalance": { "type": "number" },
        "currentDue": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "totalPaid": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "openingBalance": { "type": "number" },
        "currentDue": { "type": "number" },
        "totalPurchased": { "type": "number" },
        "totalPaid": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Sales invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentAccountId": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "invoiceNo", "total"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Purchase order / invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "items": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentAccountId": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "invoiceNo", "total"]
    },
    "Account": {
      "title": "Account",
      "description": "Financial cash, bank, or MFS account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["cash", "bank", "mfs"] },
        "accountNumber": { "type": "string" },
        "balance": { "type": "number" },
        "bankName": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "type"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expense entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "accountId": { "type": "string" },
        "accountName": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "category", "amount"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Audit of inventory adjustments and stock in/out",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "referenceId": { "type": "string" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "productId", "type", "quantity"]
    },
    "Return": {
      "title": "Return",
      "description": "Sales or purchase return record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "returnType": { "type": "string" },
        "invoiceId": { "type": "string" },
        "invoiceNo": { "type": "string" },
        "partyId": { "type": "string" },
        "partyName": { "type": "string" },
        "items": { "type": "string" },
        "totalRefund": { "type": "number" },
        "paymentAccountId": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "returnType", "totalRefund"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and activity audit records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "recordId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "actorUid", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Business organizations"
    },
    "/businesses/{businessId}/members/{memberId}": {
      "schema": "BusinessMember",
      "description": "Staff and role permissions"
    },
    "/businesses/{businessId}/products/{productId}": {
      "schema": "Product",
      "description": "Inventory catalog"
    },
    "/businesses/{businessId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer accounts and dues"
    },
    "/businesses/{businessId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Supplier accounts and dues"
    },
    "/businesses/{businessId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales invoices"
    },
    "/businesses/{businessId}/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Purchase records"
    },
    "/businesses/{businessId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "Cash/Bank/MFS accounts"
    },
    "/businesses/{businessId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business expenses"
    },
    "/businesses/{businessId}/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Stock audit trails"
    },
    "/businesses/{businessId}/returns/{returnId}": {
      "schema": "Return",
      "description": "Product return logs"
    },
    "/businesses/{businessId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Business audit trail"
    }
  }
}
