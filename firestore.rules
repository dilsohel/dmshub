rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
      );
    }

    function isBusinessMember(businessId) {
      return isSignedIn() && (
        isBusinessOwner(businessId) ||
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
      );
    }

    // Users collection (isolated to owner)
    match /users/{userId} {
      allow get, write: if isOwner(userId);
      allow list: if isSignedIn() && request.auth.uid == userId;
    }

    // Businesses collection
    match /businesses/{businessId} {
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
      );
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if isBusinessOwner(businessId);
      allow delete: if isBusinessOwner(businessId);

      // Business Members subcollection
      match /members/{memberId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessOwner(businessId);
      }

      // Products subcollection
      match /products/{productId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Customers subcollection
      match /customers/{customerId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Suppliers subcollection
      match /suppliers/{supplierId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Sales subcollection
      match /sales/{saleId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Purchases subcollection
      match /purchases/{purchaseId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Accounts subcollection (Cash / Bank / MFS)
      match /accounts/{accountId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Stock movements
      match /stockMovements/{movementId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Returns subcollection
      match /returns/{returnId} {
        allow read: if isBusinessMember(businessId);
        allow write: if isBusinessMember(businessId);
      }

      // Audit logs (Append only, never updated or deleted)
      match /auditLogs/{logId} {
        allow read: if isBusinessMember(businessId);
        allow create: if isBusinessMember(businessId);
        allow update, delete: if false;
      }
    }
  }
}
